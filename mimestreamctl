def is_transient_compose_error(error: CliError) -> bool:
    message = str(error)
    return "No front window." in message or "Could not find the From pop-up" in message


def current_compose_from_options_with_retry(*, wait_seconds: float = 0.35, attempts: int = 6) -> list[str]:
    last_error: CliError | None = None
    for attempt in range(attempts):
        try:
            return current_compose_from_options(wait_seconds=wait_seconds)
        except CliError as error:
            if not is_transient_compose_error(error):
                raise
            last_error = error
            if attempt == attempts - 1:
                raise
            time.sleep(wait_seconds)
    raise last_error or CliError("Could not read compose sender options.")


def current_compose_from_value_with_retry(*, wait_seconds: float = 0.1, attempts: int = 6) -> str:
    last_error: CliError | None = None
    for attempt in range(attempts):
        try:
            return current_compose_from_value(wait_seconds=wait_seconds)
        except CliError as error:
            if not is_transient_compose_error(error):
                raise
            last_error = error
            if attempt == attempts - 1:
                raise
            time.sleep(wait_seconds)
    raise last_error or CliError("Could not read the compose sender value.")


def normalize_sender_match(value: str) -> str:
    return " ".join(value.casefold().split())


def resolve_compose_from_choice(requested: str, options: list[str]) -> str:
    if not options:
        raise CliError("No compose sender options were found in the front draft window.")
    if requested in options:
        return requested

    normalized_requested = normalize_sender_match(requested)
    normalized_matches = [option for option in options if normalize_sender_match(option) == normalized_requested]
    if len(normalized_matches) == 1:
        return normalized_matches[0]

    contains_matches = [option for option in options if normalized_requested in normalize_sender_match(option)]
    if len(contains_matches) == 1:
        return contains_matches[0]

    if normalized_matches or contains_matches:
        matches = normalized_matches or contains_matches
        raise CliError(
            f"Ambiguous --from value {requested!r}. Matching options:\n- " + "\n- ".join(matches)
        )

    raise CliError(
        f"Unknown --from value {requested!r}. Available options:\n- " + "\n- ".join(options)
    )


def select_compose_from(sender: str, *, wait_seconds: float = 0.35) -> str:
    options = current_compose_from_options_with_retry(wait_seconds=wait_seconds)
    selected_option = resolve_compose_from_choice(sender, options)
    script = f"""
tell application {applescript_string(APP_NAME)} to activate
delay {wait_seconds}
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        if not (exists front window) then
            error "No front window."
        end if
        set draftWindow to front window
        set fromPopup to missing value
        set totalElements to count of UI elements of draftWindow
        repeat with i from 1 to totalElements
            set candidateLabel to UI element i of draftWindow
            if role of candidateLabel is "AXStaticText" then
                set candidateName to name of candidateLabel
                if candidateName is "From:" and i < totalElements then
                    set candidatePopup to UI element (i + 1) of draftWindow
                    if role of candidatePopup is "AXPopUpButton" then
                        set fromPopup to candidatePopup
                        exit repeat
                    end if
                end if
            end if
        end repeat
        if fromPopup is missing value then
            error "Could not find the From pop-up in the front draft window."
        end if
        perform action "AXShowMenu" of fromPopup
        delay 0.1
        if not (exists menu item {applescript_string(selected_option)} of menu 1 of fromPopup) then
            error "Compose sender not found: " & {applescript_string(selected_option)}
        end if
        click menu item {applescript_string(selected_option)} of menu 1 of fromPopup
        delay 0.2
    end tell
end tell
"""
    run_osascript(script)
    selected_value = current_compose_from_value_with_retry(wait_seconds=0.1)
    if normalize_sender_match(selected_value) != normalize_sender_match(selected_option):
        raise CliError(f"Failed to select compose sender {selected_option!r}; got {selected_value!r} instead.")
    return selected_value


