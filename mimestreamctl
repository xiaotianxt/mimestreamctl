def parse_positive_int(value: str, *, label: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise CliError(f"{label} must be a positive integer.") from exc
    if parsed <= 0:
        raise CliError(f"{label} must be a positive integer.")
    return parsed


def resolve_list_request(tokens: list[str]) -> tuple[str, int | None]:
    if not tokens:
        return ("latest", 100)
    if len(tokens) > 2:
        raise CliError("Use `list`, `list 100`, `list latest 100`, or `list all`.")

    first = tokens[0]
    if first == "all":
        if len(tokens) != 1:
            raise CliError("`list all` does not take an extra row count.")
        return ("all", None)

    if first == "latest":
        if len(tokens) == 1:
            return ("latest", 100)
        return ("latest", parse_positive_int(tokens[1], label="latest row count"))

    if len(tokens) == 1:
        return ("latest", parse_positive_int(first, label="list row count"))

    raise CliError("Use `list`, `list 100`, `list latest 100`, or `list all`.")


