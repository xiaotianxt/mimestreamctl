    for key in ["private_link", "mimestream_open_url", "gmail_url"]:
        if links.get(key):
            print(f"{key}: {links[key]}")


def cmd_selection(args: argparse.Namespace) -> None:
    selection = current_selection()
    if args.first:
        selection = selection[:1]
    if args.json:
        print_json({"selection": selection})
        return
    for item in selection:
        print(item)


def cmd_read(args: argparse.Namespace) -> None:
    output_format = resolve_output_format(args)
    selection = current_selection()
    selection_item = selection[0] if selection else None
    selection_title, selection_url = parse_markdown_link(selection_item) if selection_item else (None, None)
    metadata = read_current_message_ax(full=args.full, include_body=not args.no_body)
    metadata["title"] = selection_title
    if selection_title:
        metadata["subject"] = selection_title
    metadata.update(derive_message_links(selection_url))
    if args.max_chars is not None and metadata.get("body") is not None:
        metadata["body"] = metadata["body"][: args.max_chars]

    if output_format == "json":
        print_json(metadata)
        return
    if output_format == "plain":
        render_read_plain(metadata)
        return
    render_read_markdown(metadata)


def cmd_links(args: argparse.Namespace) -> None:
    output_format = resolve_output_format(args)
    selection = current_selection()
    selection_item = selection[0] if selection else None
    selection_title, selection_url = parse_markdown_link(selection_item) if selection_item else (None, None)
    links = derive_message_links(selection_url)
    if output_format == "json":
        print_json({"title": selection_title, **links})
        return
    if output_format == "plain":
        render_links_plain(links)
        return
    render_links_markdown(selection_title, links)


def cmd_activate(_: argparse.Namespace) -> None:
    activate_mimestream()


def cmd_menus(args: argparse.Namespace) -> None:
    if args.all:
        menu_names = top_menus()
        payload = {name: menu_items(name) for name in menu_names}
    elif args.menu:
        payload = {name: menu_items(name) for name in args.menu}
    else:
        payload = {"menus": top_menus()}

    if args.json:
        print_json(payload)
        return

    if "menus" in payload:
        for name in payload["menus"]:
            print(name)
        return

    first = True
    for name, items in payload.items():
        if not first:
            print()
        first = False
        print(f"[{name}]")
        for item in items:
            print(item)


def cmd_click(args: argparse.Namespace) -> None:
    click_menu_item(args.menu, args.item, dry_run=args.dry_run)


def run_reply_flow(
    menu_item: str,
    *,
    body: str | None,
    dry_run: bool,
    wait_seconds: float,
    send: bool,
    send_and_archive: bool,
    confirm: bool,
    restore_clipboard: bool,
) -> None:
    start_reply(menu_item, dry_run=dry_run)
    if dry_run:
        if body is not None:
            print("Would paste reply body into the new draft")
        if send:
            print("Would send the reply draft")
        if send_and_archive:
            print("Would send and archive the reply draft")
        return
    if body is not None:
        original_clipboard = get_text_clipboard()
        try:
            set_text_clipboard(body)
            paste_into_mimestream(delay_seconds=wait_seconds)
        finally:
            if restore_clipboard:
                set_text_clipboard(original_clipboard)
    if send or send_and_archive:
        if not confirm:
            raise CliError("Sending a reply requires --confirm.")
        if send_and_archive:
            click_menu_item("Message", "Send and Archive")
        else:
            click_menu_item("Message", "Send")


def cmd_action(args: argparse.Namespace) -> None:
    action = ACTIONS[args.command]
    require_confirmation(args, action)
    click_menu_item(action.menu, action.item, dry_run=args.dry_run)


def cmd_go(args: argparse.Namespace) -> None:
    destination = GO_DESTINATIONS[args.destination]
    click_menu_item("Go", destination, dry_run=args.dry_run)


def cmd_move(args: argparse.Namespace) -> None:
    start_move(args.destination, dry_run=args.dry_run, open_delay=args.delay)


def cmd_compose(args: argparse.Namespace) -> None:
    body = read_text_argument(args.body, args.body_file)
    url = compose_mailto_url(args.to or [], args.cc or [], args.bcc or [], args.subject, body)
    if args.print_url or args.dry_run:
        print(url)
        if args.from_sender:
            print(f"Would select From matching: {args.from_sender}")
        if args.dry_run:
            return
    run_open(url)
    if args.from_sender:
        select_compose_from(args.from_sender, wait_seconds=args.delay)


def cmd_reply(args: argparse.Namespace) -> None:
    body = read_text_argument(args.body, args.body_file)
    run_reply_flow(
        "Reply",
        body=body,
        dry_run=args.dry_run,
        wait_seconds=args.delay,
        send=args.send,
        send_and_archive=args.send_and_archive,
        confirm=args.confirm,
        restore_clipboard=not args.no_restore_clipboard,
    )


def cmd_reply_all(args: argparse.Namespace) -> None:
    body = read_text_argument(args.body, args.body_file)
    run_reply_flow(
        "Reply All",
        body=body,
        dry_run=args.dry_run,
        wait_seconds=args.delay,
        send=args.send,
        send_and_archive=args.send_and_archive,
        confirm=args.confirm,
        restore_clipboard=not args.no_restore_clipboard,
    )


def cmd_insert_text(args: argparse.Namespace) -> None:
    text = read_text_argument(args.text, args.file)
    if text is None:
        raise CliError("Pass text or --file.")
    if args.dry_run:
        print(text)
        print("\nWould paste the text into the frontmost Mimestream control.")
        return
    original_clipboard = get_text_clipboard()
    try:
        set_text_clipboard(text)
        paste_into_mimestream(delay_seconds=args.delay)
    finally:
        if not args.no_restore_clipboard:
            set_text_clipboard(original_clipboard)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mimestreamctl",
        description="Thin CLI for driving the Mimestream macOS app.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    selection_parser = subparsers.add_parser("selection", help="Show the current Mimestream selection.")
    selection_parser.add_argument("--json", action="store_true", help="Emit JSON output.")
    selection_parser.add_argument("--first", action="store_true", help="Print only the first selected item.")
    selection_parser.set_defaults(func=cmd_selection)

    read_parser = subparsers.add_parser("read", help="Read metadata and body text for the current message.")
    read_parser.add_argument("--format", choices=["markdown", "plain", "json"], default="markdown", help="Output format. Defaults to markdown.")
    read_parser.add_argument("--json", action="store_true", help="Emit JSON output.")
    mode_group = read_parser.add_mutually_exclusive_group()
    mode_group.add_argument("--full", action="store_true", help="Include extra row metadata such as sender, date, and preview.")
    mode_group.add_argument("--fast", action="store_true", help=argparse.SUPPRESS)
    read_parser.add_argument("--no-body", action="store_true", help="Skip copying the visible message body.")
    read_parser.add_argument("--max-chars", type=int, help="Truncate the copied body to this many characters.")
    read_parser.set_defaults(func=cmd_read)

    links_parser = subparsers.add_parser("links", help="Show known URLs for the current message selection.")
    links_parser.add_argument("--format", choices=["markdown", "plain", "json"], default="markdown", help="Output format. Defaults to markdown.")
    links_parser.add_argument("--json", action="store_true", help="Emit JSON output.")
    links_parser.set_defaults(func=cmd_links)

    activate_parser = subparsers.add_parser("activate", help="Bring Mimestream to the foreground.")
    activate_parser.set_defaults(func=cmd_activate)

    menus_parser = subparsers.add_parser("menus", help="List top-level menus or menu items.")
    menus_parser.add_argument("menu", nargs="*", help="Specific top-level menu names to inspect.")
    menus_parser.add_argument("--all", action="store_true", help="List every top-level menu and its items.")
    menus_parser.add_argument("--json", action="store_true", help="Emit JSON output.")
    menus_parser.set_defaults(func=cmd_menus)

    click_parser = subparsers.add_parser("click", help="Click an arbitrary menu item.")
    click_parser.add_argument("menu", help="Top-level menu name, for example Message.")
    click_parser.add_argument("item", help="Exact menu item name.")
    click_parser.add_argument("--dry-run", action="store_true", help="Print the action without clicking.")
    click_parser.set_defaults(func=cmd_click)

    go_parser = subparsers.add_parser("go", help="Jump to a built-in mailbox via the Go menu.")
    go_parser.add_argument("destination", choices=sorted(GO_DESTINATIONS), help="Mailbox destination.")
    go_parser.add_argument("--dry-run", action="store_true", help="Print the action without clicking.")
    go_parser.set_defaults(func=cmd_go)

    move_parser = subparsers.add_parser("move", help="Move the current selection to an arbitrary mailbox or label.")
    move_parser.add_argument("destination", help="Mailbox or label name to type into Move to….")
    move_parser.add_argument("--delay", type=float, default=0.15, help="Seconds to wait between opening Move to… and confirming the destination.")
    move_parser.add_argument("--dry-run", action="store_true", help="Print the action without typing into MimeStream.")
    move_parser.set_defaults(func=cmd_move)

    compose_parser = subparsers.add_parser("compose", help="Open a new draft in Mimestream and optionally select the sender.")
    compose_parser.add_argument("--to", action="append", help="Primary recipient. Repeat for multiple recipients.")
    compose_parser.add_argument("--cc", action="append", help="CC recipient. Repeat for multiple recipients.")
    compose_parser.add_argument("--bcc", action="append", help="BCC recipient. Repeat for multiple recipients.")
    compose_parser.add_argument("--from", dest="from_sender", help="Sender identity to choose from the compose window. Accepts the full label or a unique substring, such as an email address.")
    compose_parser.add_argument("--subject", help="Draft subject.")
    compose_parser.add_argument("--body", help="Draft body text.")
    compose_parser.add_argument("--body-file", help="Read the draft body from a file.")
    compose_parser.add_argument("--delay", type=float, default=0.35, help="Seconds to wait for the draft window before selecting --from.")
    compose_parser.add_argument("--print-url", action="store_true", help="Print the generated mailto: URL.")
    compose_parser.add_argument("--dry-run", action="store_true", help="Print the generated mailto: URL without opening it.")
    compose_parser.set_defaults(func=cmd_compose)

    reply_parser = subparsers.add_parser("reply", help="Open a reply draft, optionally insert body text, and optionally send it.")
    reply_parser.add_argument("--body", help="Reply body text.")
    reply_parser.add_argument("--body-file", help="Read the reply body from a file.")
    reply_parser.add_argument("--delay", type=float, default=0.2, help="Seconds to wait for the reply draft before pasting.")
    reply_parser.add_argument("--send", action="store_true", help="Send the reply after pasting.")
    reply_parser.add_argument("--send-and-archive", action="store_true", help="Send the reply and archive the conversation.")
    reply_parser.add_argument("--confirm", action="store_true", help="Required when using --send or --send-and-archive.")
    reply_parser.add_argument("--no-restore-clipboard", action="store_true", help="Leave the reply body text on the clipboard.")
    reply_parser.add_argument("--dry-run", action="store_true", help="Print the action without touching MimeStream.")
    reply_parser.set_defaults(func=cmd_reply)

    reply_all_parser = subparsers.add_parser("reply-all", help="Open a reply-all draft, optionally insert body text, and optionally send it.")
    reply_all_parser.add_argument("--body", help="Reply-all body text.")
    reply_all_parser.add_argument("--body-file", help="Read the reply-all body from a file.")
    reply_all_parser.add_argument("--delay", type=float, default=0.2, help="Seconds to wait for the reply-all draft before pasting.")
    reply_all_parser.add_argument("--send", action="store_true", help="Send the reply-all after pasting.")
    reply_all_parser.add_argument("--send-and-archive", action="store_true", help="Send the reply-all and archive the conversation.")
    reply_all_parser.add_argument("--confirm", action="store_true", help="Required when using --send or --send-and-archive.")
    reply_all_parser.add_argument("--no-restore-clipboard", action="store_true", help="Leave the reply-all body text on the clipboard.")
    reply_all_parser.add_argument("--dry-run", action="store_true", help="Print the action without touching MimeStream.")
    reply_all_parser.set_defaults(func=cmd_reply_all)

    insert_parser = subparsers.add_parser("insert-text", help="Paste text into the currently focused Mimestream control.")
    insert_parser.add_argument("text", nargs="?", help="Inline text to paste.")
    insert_parser.add_argument("--file", help="Read pasted text from a file.")
    insert_parser.add_argument("--delay", type=float, default=0.15, help="Seconds to wait after activating Mimestream before pasting.")
    insert_parser.add_argument("--no-restore-clipboard", action="store_true", help="Leave the pasted text on the clipboard.")
    insert_parser.add_argument("--dry-run", action="store_true", help="Print the text instead of pasting it.")
    insert_parser.set_defaults(func=cmd_insert_text)

    for name, action in ACTIONS.items():
        action_parser = subparsers.add_parser(name, help=action.help)
        action_parser.add_argument("--confirm", action="store_true", help="Required for destructive commands.")
        action_parser.add_argument("--dry-run", action="store_true", help="Print the action without clicking.")
        action_parser.set_defaults(func=cmd_action)

    return parser


def main(argv: Iterable[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    try:
        args.func(args)
    except CliError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
