    mail_unsubscribe_parser.add_argument("--no-submit-forms", action="store_true", help="Do not auto-submit simple unsubscribe confirmation forms.")
    mail_unsubscribe_parser.add_argument("--timeout", type=float, default=20.0, help="HTTP timeout per unsubscribe request in seconds.")
    mail_unsubscribe_parser.add_argument("--show-urls", action="store_true", help="Show full unsubscribe URLs instead of redacted URL previews.")
    mail_unsubscribe_parser.add_argument("--summary-only", action="store_true", help="Only print aggregate counts; omit per-message plans/results.")
    mail_unsubscribe_parser.add_argument("--write-ids", help="Write the matched local message ids to this file for an exact follow-up action.")
    mail_unsubscribe_parser.set_defaults(func=cmd_mail_unsubscribe)

    for name, action in ACTIONS.items():
        action_parser = subparsers.add_parser(name, help=action.help)
        action_parser.add_argument("--confirm", action="store_true", help="Required for destructive commands.")
        action_parser.add_argument("--dry-run", action="store_true", help="Print the action without clicking.")
        action_parser.set_defaults(func=cmd_action)

    return parser


def main(argv: Iterable[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    try:
        args.func(args)
    except CliError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("Interrupted.", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
