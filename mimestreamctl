def add_message_id(ids: list[int], value: object) -> None:
    if isinstance(value, bool):
        return
    if isinstance(value, int):
        ids.append(value)
        return
    if isinstance(value, str) and value.isdigit():
        ids.append(int(value))


def collect_message_ids(payload: object) -> list[int]:
    ids: list[int] = []
    if isinstance(payload, list):
        for item in payload:
            if isinstance(item, dict):
                add_message_id(ids, item.get("id"))
                message = item.get("message")
                if isinstance(message, dict):
                    add_message_id(ids, message.get("id"))
            else:
                add_message_id(ids, item)
        return ids

    if not isinstance(payload, dict):
        return ids

    raw_ids = payload.get("ids")
    if isinstance(raw_ids, list):
        for item in raw_ids:
            add_message_id(ids, item)

    for key in ("messages", "targets", "results"):
        items = payload.get(key)
        if not isinstance(items, list):
            continue
        for item in items:
            if isinstance(item, dict):
                add_message_id(ids, item.get("id"))
                message = item.get("message")
                if isinstance(message, dict):
                    add_message_id(ids, message.get("id"))

    plans = payload.get("plans")
    if isinstance(plans, list):
        for plan in plans:
            if isinstance(plan, dict):
                message = plan.get("message")
                if isinstance(message, dict):
                    add_message_id(ids, message.get("id"))
    return ids


def unique_message_ids(ids: Iterable[int]) -> list[int]:
    seen: set[int] = set()
    unique: list[int] = []
    for message_id in ids:
        if message_id in seen:
            continue
        seen.add(message_id)
        unique.append(message_id)
    return unique


def load_message_ids(path: str) -> list[int]:
    id_path = Path(path).expanduser()
    try:
        text = id_path.read_text(encoding="utf-8")
    except OSError as exc:
        raise CliError(f"Could not read ids file {id_path}: {exc}") from exc
    stripped = text.strip()
    if not stripped:
        return []

    try:
        payload = json.loads(stripped)
    except json.JSONDecodeError:
        return unique_message_ids(int(match.group(0)) for match in re.finditer(r"\d+", stripped))
    return unique_message_ids(collect_message_ids(payload))


def write_message_ids(path: str, ids: Iterable[int]) -> dict[str, Any]:
    id_path = Path(path).expanduser()
    try:
        id_path.parent.mkdir(parents=True, exist_ok=True)
        unique_ids = unique_message_ids(ids)
        body = "\n".join(str(message_id) for message_id in unique_ids)
        id_path.write_text(f"{body}\n" if body else "", encoding="utf-8")
    except OSError as exc:
        raise CliError(f"Could not write ids file {id_path}: {exc}") from exc
    return {"path": str(id_path), "count": len(unique_ids)}


def counter_items(counter: Counter[str], *, key: str, limit: int | None = None) -> list[dict[str, Any]]:
    items = sorted(counter.items(), key=lambda item: (-item[1], item[0]))
    if limit is not None:
        items = items[:limit]
    return [{key: label, "count": count} for label, count in items]


def message_account_label(message: dict[str, Any]) -> str:
    account = message.get("account")
    if isinstance(account, dict):
        for key in ("email", "name", "user_id", "id"):
            value = account.get(key)
            if value is not None and str(value):
                return str(value)
    return "unknown"


def summarize_messages(messages: Iterable[dict[str, Any]]) -> dict[str, Any]:
    items = list(messages)
    return {
        "count": len(items),
        "by_account": counter_items(Counter(message_account_label(message) for message in items), key="account"),
        "by_sender": counter_items(Counter(str(message.get("from") or "unknown") for message in items), key="from"),
        "top_subjects": counter_items(Counter(str(message.get("subject") or "(No subject)") for message in items), key="subject", limit=12),
    }


def plan_messages(plans: Iterable[dict[str, Any]]) -> list[dict[str, Any]]:
    messages: list[dict[str, Any]] = []
    for plan in plans:
        message = plan.get("message")
        if isinstance(message, dict):
            messages.append(message)
    return messages


def summarize_unsubscribe_plans(plans: list[dict[str, Any]]) -> dict[str, Any]:
    summary = summarize_messages(plan_messages(plans))
    summary.update(
        {
            "executable_count": sum(1 for plan in plans if plan.get("can_execute")),
            "blocked_count": sum(1 for plan in plans if not plan.get("can_execute")),
            "by_method": counter_items(Counter(str(plan.get("method") or "none") for plan in plans), key="method"),
        }
    )
    blocked_reasons = Counter(str(plan.get("reason") or "unknown") for plan in plans if not plan.get("can_execute"))
    if blocked_reasons:
        summary["blocked_reasons"] = counter_items(blocked_reasons, key="reason")
    return summary


def summarize_unsubscribe_results(results: list[dict[str, Any]]) -> dict[str, Any]:
    summary = summarize_messages(plan_messages(results))
    summary["status_counts"] = dict(Counter(str(result.get("status") or "unknown") for result in results))
    return summary


def load_account_emails_by_user_id(path: Path = DEFAULT_MIMESTREAM_PERSISTENCE) -> dict[str, str]:
    try:
        with path.open("rb") as handle:
            payload = plistlib.load(handle)
    except OSError as exc:
        raise CliError(f"Could not read Mimestream account metadata: {exc}") from exc
    except plistlib.InvalidFileException as exc:
        raise CliError(f"Could not parse Mimestream account metadata: {exc}") from exc

    accounts = payload.get("accounts", [])
    if not isinstance(accounts, list):
        return {}

    emails: dict[str, str] = {}
    for account in accounts:
        if not isinstance(account, dict):
            continue
        user_id = account.get("userID")
        email = account.get("email")
        if user_id and email:
            emails[str(user_id)] = str(email)
    return emails


def trash_target_for_row(row: sqlite3.Row, emails_by_user_id: dict[str, str]) -> dict[str, Any]:
    message = message_row_to_dict(row, include_body=False, include_headers=False)
    user_id = str(row["account_user_id"] or "")
    account = message.get("account")
    if isinstance(account, dict):
        account["email"] = emails_by_user_id.get(user_id)
    return message


def execute_gmail_trash(row: sqlite3.Row, emails_by_user_id: dict[str, str]) -> dict[str, Any]:
    result = trash_target_for_row(row, emails_by_user_id)
    account = result.get("account") if isinstance(result.get("account"), dict) else {}
    account_email = account.get("email") if isinstance(account, dict) else None
    server_id = result.get("server_id")

    if not account_email:
        return {**result, "status": "failed", "reason": "could not resolve account email from Mimestream account metadata"}
    if not server_id:
        return {**result, "status": "failed", "reason": "message has no Gmail server id"}

    params = json.dumps({"userId": account_email, "id": server_id})
    proc = run_process(["gws", "gmail", "users", "messages", "trash", "--params", params])
    if proc.returncode != 0:
        return {**result, "status": "failed", "reason": normalize_error(proc.stderr or proc.stdout)}

    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError:
        payload = {}
    return {**result, "status": "success", "label_ids": payload.get("labelIds")}


def cmd_mail_trash(args: argparse.Namespace) -> None:
    if not args.dry_run and not args.confirm:
        raise CliError("`mail trash` requires --confirm unless --dry-run is set.")
    if not mail_args_have_filter(args):
        raise CliError("Pass --id or at least one filter such as --from, --subject, --query, or --since.")

    matched_rows = fetch_messages(args, include_body=False, require_unsubscribe_signal=args.unsubscribe_only)
    already_trashed_count = sum(1 for row in matched_rows if row["is_trashed"])
    rows = matched_rows
    if not args.include_trashed:
        rows = [row for row in rows if not row["is_trashed"]]
    emails_by_user_id = load_account_emails_by_user_id()
    targets = [trash_target_for_row(row, emails_by_user_id) for row in rows]
    ids_file = write_message_ids(args.write_ids, (row["id"] for row in rows)) if args.write_ids else None

    if args.dry_run:
        by_account = Counter(
            (
                target.get("account", {}).get("email")
                if isinstance(target.get("account"), dict)
                else None
            )
            or (
                target.get("account", {}).get("user_id")
                if isinstance(target.get("account"), dict)
                else "unknown"
            )
            for target in targets
        )
        summary = summarize_messages(targets)
        summary.update(
            {
                "matched_count": len(matched_rows),
                "target_count": len(targets),
                "already_trashed_count": already_trashed_count,
                "skipped_already_trashed_count": 0 if args.include_trashed else already_trashed_count,
            }
        )
        payload: dict[str, Any] = {
            "mode": "dry_run",
            "count": len(targets),
            "matched_count": len(matched_rows),
            "target_count": len(targets),
            "already_trashed_count": already_trashed_count,
            "skipped_already_trashed_count": 0 if args.include_trashed else already_trashed_count,
            "by_account": dict(by_account),
            "summary": summary,
        }
        if ids_file:
            payload["ids_file"] = ids_file
        if not args.summary_only:
            payload["targets"] = targets
        print_json(payload)
        return

    results = [execute_gmail_trash(row, emails_by_user_id) for row in rows]
    status_counts = Counter(str(result.get("status") or "unknown") for result in results)
    summary = summarize_messages(results)
    summary.update(
        {
            "matched_count": len(matched_rows),
            "target_count": len(results),
            "already_trashed_count": already_trashed_count,
            "skipped_already_trashed_count": 0 if args.include_trashed else already_trashed_count,
            "status_counts": dict(status_counts),
        }
    )
    payload = {
        "mode": "execute",
        "count": len(results),
        "matched_count": len(matched_rows),
        "target_count": len(results),
        "already_trashed_count": already_trashed_count,
        "skipped_already_trashed_count": 0 if args.include_trashed else already_trashed_count,
        "status_counts": dict(status_counts),
        "summary": summary,
    }
    if ids_file:
        payload["ids_file"] = ids_file
    if not args.summary_only:
        payload["results"] = results
    print_json(payload)


def cmd_mail_unsubscribe(args: argparse.Namespace) -> None:
    if not args.dry_run and not args.confirm:
        raise CliError("`mail unsubscribe` requires --confirm unless --dry-run is set.")
    if not mail_args_have_filter(args):
        raise CliError("Pass --id or at least one filter such as --from, --subject, --query, or --since.")

    rows = fetch_messages(args, include_body=True, require_unsubscribe_signal=True, filter_transactional=False)
    plans = []
    for row in rows:
        if not args.include_transactional and looks_transactional(row):
            plans.append(
                {
                    "message": message_row_to_dict(row, include_body=False, include_headers=True),
                    "source": None,
                    "method": None,
                    "url": None,
                    "url_preview": None,
                    "can_execute": False,
                    "reason": "looks like transactional/security/billing mail; pass --include-transactional to override",
                }
            )
            continue
        plans.append(unsubscribe_plan_for_row(row, allow_body_links=not args.headers_only))
    executable = [plan for plan in plans if plan.get("can_execute")]
    blocked = [plan for plan in plans if not plan.get("can_execute")]
    ids_file = (
        write_message_ids(
            args.write_ids,
            (message["id"] for message in plan_messages(plans) if isinstance(message.get("id"), int)),
        )
        if args.write_ids
        else None
    )

    if args.dry_run:
        payload: dict[str, Any] = {
            "mode": "dry_run",
            "count": len(plans),
            "executable_count": len(executable),
            "blocked_count": len(blocked),
            "summary": summarize_unsubscribe_plans(plans),
        }
        if ids_file:
            payload["ids_file"] = ids_file
        if not args.summary_only:
            payload["plans"] = [sanitize_plan_for_output(plan, show_urls=args.show_urls) for plan in plans]
        print_json(payload)
        return

    results = [
        execute_unsubscribe_plan(
            plan,
            timeout_seconds=args.timeout,
            submit_forms=not args.no_submit_forms,
        )
        for plan in executable
    ]
    results.extend({**plan, "status": "skipped"} for plan in blocked)

    counts: dict[str, int] = {}
    for result in results:
        status = str(result.get("status") or "unknown")
        counts[status] = counts.get(status, 0) + 1

    payload = {
        "mode": "execute",
        "count": len(results),
        "status_counts": counts,
        "summary": summarize_unsubscribe_results(results),
    }
    if ids_file:
        payload["ids_file"] = ids_file
    if not args.summary_only:
        payload["results"] = [sanitize_plan_for_output(result, show_urls=args.show_urls) for result in results]
    print_json(payload)


