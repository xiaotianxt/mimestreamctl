        end if
        perform action "AXShowMenu" of fromPopup
        delay 0.1
        set optionTitles to {{}}
        repeat with candidateItem in every menu item of menu 1 of fromPopup
            set itemTitle to title of candidateItem
            if itemTitle is not missing value and itemTitle is not "" then
                copy (itemTitle as text) to end of optionTitles
