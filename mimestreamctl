def ax_reader_source_path() -> Path:
    return Path(__file__).with_name("mimestream_ax_text.swift")


def ax_reader_binary_path() -> Path:
    return Path("/tmp/mimestreamctl-ax-text")


def ensure_ax_reader_binary() -> Path:
    source_path = ax_reader_source_path()
    binary_path = ax_reader_binary_path()
    if binary_path.exists() and binary_path.stat().st_mtime >= source_path.stat().st_mtime:
        return binary_path
    proc = run_process(["swiftc", str(source_path), "-O", "-o", str(binary_path)])
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    return binary_path


def read_current_message_ax(*, full: bool = False, include_body: bool = True) -> dict[str, Any]:
    activate_mimestream(delay_seconds=0.05)
    binary_path = ensure_ax_reader_binary()
    argv = [str(binary_path), "--json"]
    if full:
        argv.append("--full")
    if not include_body:
        argv.append("--no-body")
    proc = run_process(argv)
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise CliError(f"Could not decode AX helper output: {exc}") from exc
    if not isinstance(payload, dict):
        raise CliError("Unexpected AX helper output.")
    return {key: value for key, value in payload.items() if value is not None}


def list_current_messages_ax(*, mode: str, count: int | None = None) -> dict[str, Any]:
    activate_mimestream(delay_seconds=0.05)
    binary_path = ensure_ax_reader_binary()
    argv = [str(binary_path), "--json", "--list"]
    if mode == "all":
        argv.append("--all")
    else:
        argv.extend(["--latest", str(count if count is not None else 100)])
    proc = run_process(argv)
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise CliError(f"Could not decode AX helper output: {exc}") from exc
    if not isinstance(payload, dict):
        raise CliError("Unexpected AX helper output.")
    rows: list[dict[str, Any]] = []
    raw_rows = payload.get("rows")
    if isinstance(raw_rows, list):
        for item in raw_rows:
            if isinstance(item, dict):
                rows.append({key: value for key, value in item.items() if value is not None})
    normalized = {key: value for key, value in payload.items() if key != "rows" and value is not None}
    normalized["rows"] = rows
    return normalized


def read_current_message_ax_with_retry(
    *,
    selection_url: str | None,
    full: bool = False,
    include_body: bool = True,
) -> dict[str, Any]:
    try:
        return read_current_message_ax(full=full, include_body=include_body)
    except CliError as exc:
        if "Could not find the focused Mimestream window." not in str(exc):
            raise
        message_links = derive_message_links(selection_url)
        open_url = message_links.get("mimestream_open_url")
        if not open_url:
            raise
        run_open(open_url)
        time.sleep(0.35)
        return read_current_message_ax(full=full, include_body=include_body)


def normalize_body_links(raw_links: object) -> list[dict[str, str]]:
    if not isinstance(raw_links, list):
        return []
    deduped_by_url: dict[str, dict[str, str]] = {}
    order: list[str] = []
    for item in raw_links:
        if not isinstance(item, dict):
            continue
        url = item.get("url")
        text = item.get("text")
        if not isinstance(url, str) or not url:
            continue
        normalized: dict[str, str] = {"url": url}
        if isinstance(text, str) and text.strip():
            normalized["text"] = text.strip()
        existing = deduped_by_url.get(url)
        if existing is None:
            deduped_by_url[url] = normalized
            order.append(url)
            continue
        if len(normalized.get("text", "")) > len(existing.get("text", "")):
            deduped_by_url[url] = normalized
    return [deduped_by_url[url] for url in order]


def prefer_resolved_link_text(existing: dict[str, str], candidate: dict[str, str]) -> dict[str, str]:
    existing_text = existing.get("text", "")
    candidate_text = candidate.get("text", "")
    if len(candidate_text) > len(existing_text):
        return candidate
    return existing


def dedupe_links_by_effective_url(links: list[dict[str, str]]) -> list[dict[str, str]]:
    deduped: dict[str, dict[str, str]] = {}
    order: list[str] = []
    for link in links:
        effective_url = link.get("resolved_url") or link.get("url")
        if not effective_url:
            continue
        if effective_url not in deduped:
            deduped[effective_url] = link
            order.append(effective_url)
            continue
        deduped[effective_url] = prefer_resolved_link_text(deduped[effective_url], link)
    return [deduped[url] for url in order]


def is_resolvable_http_url(url: str) -> bool:
    parsed = urlparse(url)
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


def resolve_redirect_url(url: str, *, timeout_seconds: float = 10.0) -> str | None:
    if not is_resolvable_http_url(url):
        return None
    headers = {"User-Agent": "mimestreamctl/1.0"}
    requests = [
        Request(url, method="HEAD", headers=headers),
        Request(url, headers=headers),
    ]
    last_error: Exception | None = None
    for request in requests:
        try:
            with urlopen(request, timeout=timeout_seconds) as response:
                return response.geturl()
        except HTTPError as exc:
            if exc.code in {405, 501} and request.get_method() == "HEAD":
                last_error = exc
                continue
            return exc.geturl() or url
        except URLError as exc:
            last_error = exc
            continue
    if last_error is not None:
        return None
    return None


def resolve_body_links(body_links: list[dict[str, str]]) -> list[dict[str, str]]:
    resolved_links: list[dict[str, str]] = []
    for link in body_links:
        updated = dict(link)
        resolved_url = resolve_redirect_url(link["url"])
        if resolved_url and resolved_url != link["url"]:
            updated["resolved_url"] = resolved_url
        resolved_links.append(updated)
    return dedupe_links_by_effective_url(resolved_links)


def coredata_seconds(dt: datetime) -> float:
    return dt.timestamp() - CORE_DATA_EPOCH_OFFSET


def datetime_from_coredata(value: object) -> str | None:
    if value is None:
        return None
    try:
        seconds = float(value) + CORE_DATA_EPOCH_OFFSET
    except (TypeError, ValueError):
        return None
    return datetime.fromtimestamp(seconds).astimezone().isoformat(timespec="seconds")


def parse_time_filter(value: str) -> float:
    normalized = value.strip()
    match = re.fullmatch(r"(\d+)([hdw])", normalized, flags=re.IGNORECASE)
    if match:
        amount = int(match.group(1))
        unit = match.group(2).lower()
        if unit == "h":
            delta = timedelta(hours=amount)
        elif unit == "d":
            delta = timedelta(days=amount)
        else:
            delta = timedelta(weeks=amount)
        return coredata_seconds(datetime.now().astimezone() - delta)

    formats = [
        "%Y-%m-%d",
        "%Y-%m-%d %H:%M",
        "%Y-%m-%d %H:%M:%S",
    ]
    for fmt in formats:
        try:
            parsed = datetime.strptime(normalized, fmt)
        except ValueError:
            continue
        local_dt = parsed.astimezone() if parsed.tzinfo else parsed.replace(tzinfo=datetime.now().astimezone().tzinfo)
        return coredata_seconds(local_dt)

    try:
        parsed = datetime.fromisoformat(normalized)
    except ValueError as exc:
        raise CliError(f"Could not parse time filter {value!r}. Use 7d, 24h, YYYY-MM-DD, or an ISO datetime.") from exc
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=datetime.now().astimezone().tzinfo)
    return coredata_seconds(parsed.astimezone())


def mimestream_db_path(path: str | None = None) -> Path:
    db_path = Path(path).expanduser() if path else DEFAULT_MIMESTREAM_DB
    if not db_path.exists():
        raise CliError(f"Mimestream database not found: {db_path}")
    return db_path


def connect_mimestream_db(path: str | None = None) -> sqlite3.Connection:
    db_path = mimestream_db_path(path)
    conn = sqlite3.connect(str(db_path))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA query_only=ON")
    return conn


def normalized_account_name(row: sqlite3.Row) -> str | None:
    name = row["account_name"]
    if isinstance(name, str) and name.strip():
        return name
    if row["account_id"] == 1:
        return "Gmail"
    return None


def message_row_to_dict(row: sqlite3.Row, *, include_body: bool = False, include_headers: bool = True) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "id": row["id"],
        "account": {
            "id": row["account_id"],
            "name": normalized_account_name(row),
            "user_id": row["account_user_id"],
        },
        "received_at": datetime_from_coredata(row["date_received"]),
        "sent_at": datetime_from_coredata(row["date_sent"]),
        "from": row["from_header"],
        "subject": row["subject"],
        "snippet": row["snippet"],
        "server_id": row["server_id"],
        "is_trashed": bool(row["is_trashed"]),
    }
    if include_headers:
        payload["headers"] = {
            "list_id": row["list_id"],
            "list_unsubscribe": row["list_unsubscribe"],
            "list_unsubscribe_post": row["list_unsubscribe_post"],
            "message_id": row["message_id"],
            "reply_to": row["reply_to"],
        }
    if include_body:
        payload["body_text"] = row["body_text"]
        payload["body_html"] = row["body_html"]
    return payload


def account_filter_sql(value: str) -> tuple[str, list[Any]]:
    normalized = value.casefold().strip()
    if normalized.isdigit():
        return "m.ZACCOUNT = ?", [int(normalized)]
    if normalized == "gmail":
        return "(lower(coalesce(a.ZNAME, '')) = 'gmail' OR (m.ZACCOUNT = 1 AND coalesce(a.ZNAME, '') = ''))", []
    like = f"%{normalized}%"
    return "(lower(coalesce(a.ZNAME, '')) LIKE ? OR lower(coalesce(a.ZUSERID, '')) LIKE ?)", [like, like]


def message_select_sql(*, include_body: bool = False) -> str:
    body_columns = ""
    if include_body:
        body_columns = ", c.ZBODYTEXT AS body_text, c.ZBODYHTML AS body_html"
    else:
        body_columns = ", NULL AS body_text, NULL AS body_html"
    return f"""
SELECT
    m.Z_PK AS id,
    m.ZACCOUNT AS account_id,
    a.ZNAME AS account_name,
    a.ZUSERID AS account_user_id,
    m.ZDATERECEIVED AS date_received,
    m.ZDATESENT AS date_sent,
    m.ZFROMHEADER AS from_header,
    m.ZSUBJECT AS subject,
    m.ZSNIPPET AS snippet,
    m.ZSERVERID AS server_id,
    m.ZISTRASHED AS is_trashed,
    c.ZLISTID AS list_id,
    c.ZLISTUNSUBSCRIBE AS list_unsubscribe,
    c.ZLISTUNSUBSCRIBEPOST AS list_unsubscribe_post,
    c.ZMESSAGEID AS message_id,
    c.ZREPLYTO AS reply_to
    {body_columns}
FROM ZMESSAGE m
LEFT JOIN ZMESSAGECONTENT c ON c.Z_PK = m.ZCONTENT
LEFT JOIN ZACCOUNT a ON a.Z_PK = m.ZACCOUNT
"""


def fetch_messages(
    args: argparse.Namespace,
    *,
    include_body: bool = False,
    require_unsubscribe_signal: bool = False,
    filter_transactional: bool = True,
) -> list[sqlite3.Row]:
    where: list[str] = []
    params: list[Any] = []

    message_id = getattr(args, "id", None)
    if message_id is not None:
        where.append("m.Z_PK = ?")
        params.append(message_id)

    ids_file = getattr(args, "ids_file", None)
    if ids_file:
        message_ids = load_message_ids(ids_file)
        if message_ids:
            placeholders = ", ".join("?" for _ in message_ids)
            where.append(f"m.Z_PK IN ({placeholders})")
            params.extend(message_ids)
        else:
            where.append("0 = 1")

    account = getattr(args, "account", None)
    if account:
        sql, sql_params = account_filter_sql(account)
        where.append(sql)
        params.extend(sql_params)

    from_filter = getattr(args, "from_filter", None)
    if from_filter:
        where.append("lower(coalesce(m.ZFROMHEADER, '')) LIKE ?")
        params.append(f"%{from_filter.casefold()}%")

    subject_filter = getattr(args, "subject", None)
    if subject_filter:
        where.append("lower(coalesce(m.ZSUBJECT, '')) LIKE ?")
        params.append(f"%{subject_filter.casefold()}%")

    query = getattr(args, "query", None)
    if query:
        like = f"%{query.casefold()}%"
        where.append(
            "("
            "lower(coalesce(m.ZFROMHEADER, '')) LIKE ? OR "
            "lower(coalesce(m.ZSUBJECT, '')) LIKE ? OR "
            "lower(coalesce(m.ZSNIPPET, '')) LIKE ?"
            ")"
        )
        params.extend([like, like, like])

    since = getattr(args, "since", None)
    if since:
        where.append("m.ZDATERECEIVED >= ?")
        params.append(parse_time_filter(since))

    until = getattr(args, "until", None)
    if until:
        where.append("m.ZDATERECEIVED <= ?")
        params.append(parse_time_filter(until))

    if require_unsubscribe_signal:
        where.append(
            "("
            "coalesce(c.ZLISTUNSUBSCRIBE, '') != '' OR "
            "lower(coalesce(c.ZBODYHTML, '')) LIKE '%unsubscribe%' OR "
            "lower(coalesce(c.ZBODYTEXT, '')) LIKE '%unsubscribe%'"
            ")"
        )

    limit = getattr(args, "limit", None)
    if limit is None and not ids_file:
        limit = 50
    sql = message_select_sql(include_body=include_body)
    if where:
        sql += "\nWHERE " + " AND ".join(where)
    sql += "\nORDER BY m.ZDATERECEIVED DESC"
    if limit is not None:
        sql += "\nLIMIT ?"
        params.append(limit)

    with connect_mimestream_db(getattr(args, "db", None)) as conn:
        rows = list(conn.execute(sql, params))

    if filter_transactional and not getattr(args, "include_transactional", False):
        rows = [row for row in rows if not looks_transactional(row)]
    return rows


def looks_transactional(row: sqlite3.Row) -> bool:
    haystack = " ".join(
        str(value or "")
        for value in [
            row["from_header"],
            row["subject"],
            row["snippet"],
        ]
    ).casefold()
    return any(term in haystack for term in TRANSACTIONAL_TERMS)


def parse_list_unsubscribe(value: str | None) -> list[str]:
    if not value:
        return []
    bracketed = re.findall(r"<([^>]+)>", value)
    raw_items = bracketed if bracketed else [part.strip() for part in value.split(",")]
    urls: list[str] = []
    for item in raw_items:
        candidate = item.strip().strip("<>").strip()
        if not candidate:
            continue
        urls.append(candidate)
    return urls


def first_http_url(urls: Iterable[str]) -> str | None:
    for url in urls:
        parsed = urlparse(url)
        if parsed.scheme in {"http", "https"} and parsed.netloc:
            return url
    return None


def contains_unsubscribe_term(value: str | None) -> bool:
    if not value:
        return False
    normalized = html.unescape(value).casefold()
    return any(term in normalized for term in UNSUBSCRIBE_TERMS)


def normalize_space(value: str) -> str:
    return " ".join(value.split())


class LinkHTMLParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.links: list[dict[str, str]] = []
        self.active_links: list[dict[str, Any]] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag.lower() != "a":
            return
        attr_map = {key.lower(): value or "" for key, value in attrs}
        href = attr_map.get("href")
        if href:
            self.active_links.append({"url": href, "text": []})

    def handle_data(self, data: str) -> None:
        for link in self.active_links:
            link["text"].append(data)

    def handle_endtag(self, tag: str) -> None:
        if tag.lower() != "a" or not self.active_links:
            return
        link = self.active_links.pop()
        self.links.append(
            {
                "url": str(link["url"]),
                "text": normalize_space("".join(link["text"])),
            }
        )


class FormHTMLParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.forms: list[dict[str, Any]] = []
        self.current_form: dict[str, Any] | None = None
        self.current_button: dict[str, Any] | None = None

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        tag = tag.lower()
        attr_map = {key.lower(): value or "" for key, value in attrs}
        if tag == "form":
            self.current_form = {
                "method": (attr_map.get("method") or "get").lower(),
                "action": attr_map.get("action") or "",
                "controls": [],
                "buttons": [],
                "text": [],
            }
            return
        if self.current_form is None:
            return
        if tag == "input":
            control = {
                "type": (attr_map.get("type") or "text").lower(),
                "name": attr_map.get("name") or "",
                "value": attr_map.get("value") or "",
                "checked": "checked" in attr_map,
            }
            self.current_form["controls"].append(control)
            if control["type"] in {"submit", "button"}:
                self.current_form["buttons"].append({**control, "text": control["value"]})
            return
        if tag == "button":
            self.current_button = {
                "type": (attr_map.get("type") or "submit").lower(),
                "name": attr_map.get("name") or "",
                "value": attr_map.get("value") or "",
                "text_parts": [],
            }

    def handle_data(self, data: str) -> None:
        if self.current_form is not None:
            self.current_form["text"].append(data)
        if self.current_button is not None:
            self.current_button["text_parts"].append(data)

    def handle_endtag(self, tag: str) -> None:
        tag = tag.lower()
        if tag == "button" and self.current_form is not None and self.current_button is not None:
            button = dict(self.current_button)
            button["text"] = normalize_space("".join(button.pop("text_parts")))
            self.current_form["buttons"].append(button)
            self.current_button = None
            return
        if tag == "form" and self.current_form is not None:
            form = dict(self.current_form)
            form["text"] = normalize_space(" ".join(form["text"]))
            self.forms.append(form)
            self.current_form = None
            self.current_button = None


def extract_html_links(body_html: str | None, body_text: str | None = None) -> list[dict[str, str]]:
    links: list[dict[str, str]] = []
    if body_html:
        parser = LinkHTMLParser()
        parser.feed(body_html)
        links.extend(parser.links)
    if body_text:
        for match in re.finditer(r"https?://[^\s<>\"]+", body_text):
            links.append({"url": match.group(0).rstrip(").,;"), "text": ""})
    deduped: dict[str, dict[str, str]] = {}
    order: list[str] = []
    for link in links:
        url = link.get("url", "").strip()
        if not url:
            continue
        if url not in deduped:
            deduped[url] = {"url": url, "text": link.get("text", "").strip()}
            order.append(url)
        elif len(link.get("text", "")) > len(deduped[url].get("text", "")):
            deduped[url]["text"] = link.get("text", "").strip()
    return [deduped[url] for url in order]


def extract_unsubscribe_body_links(row: sqlite3.Row) -> list[dict[str, str]]:
    links = extract_html_links(row["body_html"], row["body_text"])
    candidates: list[dict[str, str]] = []
    for link in links:
        url = link.get("url", "")
        text = link.get("text", "")
        if contains_unsubscribe_term(text) or contains_unsubscribe_term(url):
            parsed = urlparse(url)
            if parsed.scheme in {"http", "https"} and parsed.netloc:
                candidates.append(link)
    return candidates


def redact_url(url: str | None) -> str | None:
    if not url:
        return None
    parsed = urlparse(url)
    if not parsed.scheme or not parsed.netloc:
        return url
    segments = [segment for segment in parsed.path.split("/") if segment]
    if not segments:
        path_preview = ""
    elif len(segments) == 1:
        path_preview = f"/{segments[0]}"
    else:
        path_preview = f"/{segments[0]}/..."
    return f"{parsed.scheme}://{parsed.netloc}{path_preview}"


def http_text_request(
    url: str,
    *,
    method: str = "GET",
    data: dict[str, str] | str | bytes | None = None,
    headers: dict[str, str] | None = None,
    timeout_seconds: float = 20.0,
) -> HttpResult:
    request_headers = {
        "User-Agent": "mimestreamctl/1.0",
    }
    if headers:
        request_headers.update(headers)
    encoded_data: bytes | None
    if isinstance(data, bytes):
        encoded_data = data
    elif isinstance(data, str):
        encoded_data = data.encode("utf-8")
    elif isinstance(data, dict):
        encoded_data = urlencode(data).encode("utf-8")
        request_headers.setdefault("Content-Type", "application/x-www-form-urlencoded")
    else:
        encoded_data = None
    request = Request(url, data=encoded_data, headers=request_headers, method=method)
    try:
        with urlopen(request, timeout=timeout_seconds) as response:
            raw = response.read()
            charset = response.headers.get_content_charset() or "utf-8"
            body = raw.decode(charset, errors="replace")
            return HttpResult(
                status=response.status,
                url=response.geturl(),
                body=body,
                content_type=response.headers.get("Content-Type"),
            )
    except HTTPError as exc:
        raw = exc.read()
        charset = exc.headers.get_content_charset() or "utf-8"
        return HttpResult(
            status=exc.code,
            url=exc.geturl() or url,
            body=raw.decode(charset, errors="replace"),
            content_type=exc.headers.get("Content-Type"),
        )
    except URLError as exc:
        raise CliError(f"HTTP request failed for {redact_url(url)}: {exc}") from exc


def html_to_visible_text(value: str) -> str:
    without_script = re.sub(r"<script\b[^>]*>.*?</script>", " ", value, flags=re.IGNORECASE | re.DOTALL)
    without_style = re.sub(r"<style\b[^>]*>.*?</style>", " ", without_script, flags=re.IGNORECASE | re.DOTALL)
    without_tags = re.sub(r"<[^>]+>", " ", without_style)
    return normalize_space(html.unescape(without_tags))


def classify_unsubscribe_response(result: HttpResult) -> tuple[str, str | None]:
    visible_text = html_to_visible_text(result.body).casefold()
    if any(term in visible_text for term in UNSUBSCRIBE_SUCCESS_TERMS):
        return "success", None
    if result.status is not None and 200 <= result.status < 300:
        if contains_unsubscribe_term(visible_text):
            return "needs_confirmation", "unsubscribe page loaded but no success confirmation was detected"
        return "unknown", "request succeeded but response did not contain a recognizable unsubscribe confirmation"
    return "failed", f"HTTP status {result.status}"


def candidate_forms_from_html(body: str) -> list[dict[str, Any]]:
    parser = FormHTMLParser()
    parser.feed(body)
    candidates = []
    for form in parser.forms:
        haystack = " ".join(
            [
                form.get("action") or "",
                form.get("text") or "",
                " ".join(str(button.get("text") or button.get("value") or "") for button in form.get("buttons", [])),
            ]
        )
        if contains_unsubscribe_term(haystack) or "confirm" in haystack.casefold():
            candidates.append(form)
    return candidates


def candidate_confirmation_links(body: str, *, base_url: str) -> list[dict[str, str]]:
    candidates: list[dict[str, str]] = []
    for link in extract_html_links(body):
        url = urljoin(base_url, link.get("url") or "")
        text = link.get("text") or ""
        haystack = f"{text} {url}"
        if not (contains_unsubscribe_term(haystack) or "confirm" in haystack.casefold()):
            continue
        parsed = urlparse(url)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            continue
        if url == base_url:
            continue
        candidates.append({"url": url, "text": text})
    return candidates


def form_has_unsafe_controls(form: dict[str, Any]) -> bool:
    for control in form.get("controls", []):
        control_type = control.get("type")
        if control_type in {"password", "file"}:
            return True
    return False


def submit_confirmation_form(
    form: dict[str, Any],
    *,
    base_url: str,
    timeout_seconds: float,
) -> HttpResult | None:
    if form_has_unsafe_controls(form):
        return None
    fields: dict[str, str] = {}
    for control in form.get("controls", []):
        name = control.get("name") or ""
        if not name:
            continue
        control_type = control.get("type") or "text"
        if control_type in {"submit", "button", "reset", "image"}:
            continue
        if control_type in {"checkbox", "radio"} and not control.get("checked"):
            continue
        fields[name] = control.get("value") or ""

    chosen_button: dict[str, Any] | None = None
    for button in form.get("buttons", []):
        label = " ".join([str(button.get("text") or ""), str(button.get("value") or "")])
        if contains_unsubscribe_term(label) or "confirm" in label.casefold() or "submit" in label.casefold():
            chosen_button = button
            break
    if chosen_button and chosen_button.get("name"):
        fields[str(chosen_button["name"])] = str(chosen_button.get("value") or chosen_button.get("text") or "")

    action_url = urljoin(base_url, form.get("action") or base_url)
    method = (form.get("method") or "get").upper()
    if method == "POST":
        return http_text_request(action_url, method="POST", data=fields, timeout_seconds=timeout_seconds)
    if method == "GET":
        separator = "&" if "?" in action_url else "?"
        target = action_url
        if fields:
            target = f"{action_url}{separator}{urlencode(fields)}"
        return http_text_request(target, timeout_seconds=timeout_seconds)
    return None


def unsubscribe_plan_for_row(row: sqlite3.Row, *, allow_body_links: bool) -> dict[str, Any]:
    header_urls = parse_list_unsubscribe(row["list_unsubscribe"])
    header_http_url = first_http_url(header_urls)
    if header_http_url:
        post_header = str(row["list_unsubscribe_post"] or "")
        one_click = "List-Unsubscribe=One-Click" in post_header
        return {
            "message": message_row_to_dict(row, include_body=False, include_headers=True),
            "source": "list_unsubscribe",
            "method": "one_click_post" if one_click else "link_get",
            "url": header_http_url,
            "url_preview": redact_url(header_http_url),
            "can_execute": True,
        }

    if any(urlparse(url).scheme == "mailto" for url in header_urls):
        return {
            "message": message_row_to_dict(row, include_body=False, include_headers=True),
            "source": "list_unsubscribe",
            "method": "mailto",
            "url": None,
            "url_preview": None,
            "can_execute": False,
            "reason": "List-Unsubscribe only provides mailto; automatic sending is intentionally unsupported",
        }

    if not allow_body_links:
        return {
            "message": message_row_to_dict(row, include_body=False, include_headers=True),
            "source": None,
            "method": None,
            "url": None,
            "url_preview": None,
            "can_execute": False,
            "reason": "no HTTP List-Unsubscribe header and body link fallback disabled",
        }

    body_links = extract_unsubscribe_body_links(row)
    if body_links:
        url = body_links[0]["url"]
        return {
            "message": message_row_to_dict(row, include_body=False, include_headers=True),
            "source": "body_link",
            "method": "link_get",
            "url": url,
            "url_preview": redact_url(url),
            "link_text": body_links[0].get("text"),
            "can_execute": True,
        }

    return {
        "message": message_row_to_dict(row, include_body=False, include_headers=True),
        "source": None,
        "method": None,
        "url": None,
        "url_preview": None,
        "can_execute": False,
        "reason": "no machine-actionable unsubscribe URL found",
    }


def execute_unsubscribe_plan(
    plan: dict[str, Any],
    *,
    timeout_seconds: float,
    submit_forms: bool,
) -> dict[str, Any]:
    if not plan.get("can_execute") or not plan.get("url"):
        return {**plan, "status": "skipped"}
    url = str(plan["url"])
    method = plan.get("method")
    try:
        if method == "one_click_post":
            result = http_text_request(
                url,
                method="POST",
                data="List-Unsubscribe=One-Click",
                headers={"Content-Type": "application/x-www-form-urlencoded"},
                timeout_seconds=timeout_seconds,
            )
        else:
            result = http_text_request(url, timeout_seconds=timeout_seconds)
    except CliError as exc:
        return {**plan, "status": "failed", "reason": str(exc)}

    status, reason = classify_unsubscribe_response(result)
    attempts = [
        {
            "method": "POST" if method == "one_click_post" else "GET",
            "url_preview": redact_url(url),
            "final_url_preview": redact_url(result.url),
            "http_status": result.status,
            "classification": status,
            "reason": reason,
        }
    ]
    if status == "needs_confirmation" and submit_forms:
        for form in candidate_forms_from_html(result.body):
            submitted = submit_confirmation_form(form, base_url=result.url, timeout_seconds=timeout_seconds)
            if submitted is None:
                continue
            submitted_status, submitted_reason = classify_unsubscribe_response(submitted)
            attempts.append(
                {
                    "method": (form.get("method") or "get").upper(),
                    "url_preview": redact_url(urljoin(result.url, form.get("action") or result.url)),
                    "final_url_preview": redact_url(submitted.url),
                    "http_status": submitted.status,
                    "classification": submitted_status,
                    "reason": submitted_reason,
                }
            )
            status = submitted_status
            reason = submitted_reason
            if status == "success":
                break
        if status == "needs_confirmation":
            for link in candidate_confirmation_links(result.body, base_url=result.url):
                submitted = http_text_request(link["url"], timeout_seconds=timeout_seconds)
                submitted_status, submitted_reason = classify_unsubscribe_response(submitted)
                attempts.append(
                    {
                        "method": "GET",
                        "url_preview": redact_url(link["url"]),
                        "final_url_preview": redact_url(submitted.url),
                        "http_status": submitted.status,
                        "classification": submitted_status,
                        "reason": submitted_reason,
                    }
                )
                status = submitted_status
                reason = submitted_reason
                if status == "success":
                    break

    output = {**plan, "status": status, "attempts": attempts}
    if reason:
        output["reason"] = reason
    if status == "needs_confirmation":
        output["manual_url_preview"] = redact_url(result.url)
    return output


def sanitize_plan_for_output(plan: dict[str, Any], *, show_urls: bool) -> dict[str, Any]:
    sanitized = dict(plan)
    if not show_urls:
        sanitized.pop("url", None)
        message = sanitized.get("message")
        if isinstance(message, dict) and isinstance(message.get("headers"), dict):
            headers = dict(message["headers"])
            if headers.get("list_unsubscribe"):
                headers["list_unsubscribe"] = "(redacted)"
            message = dict(message)
            message["headers"] = headers
            sanitized["message"] = message
    return sanitized


def sanitize_message_for_output(message: dict[str, Any], *, show_urls: bool) -> dict[str, Any]:
    if show_urls:
        return message
    sanitized = dict(message)
    headers = sanitized.get("headers")
    if isinstance(headers, dict) and headers.get("list_unsubscribe"):
        updated_headers = dict(headers)
        updated_headers["list_unsubscribe"] = "(redacted)"
        sanitized["headers"] = updated_headers
    return sanitized


def type_text_in_mimestream(text: str, *, delay_seconds: float = 0.15) -> None:
    script = f"""
tell application {applescript_string(APP_NAME)} to activate
delay {delay_seconds}
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        keystroke {applescript_string(text)}
    end tell
end tell
"""
    run_osascript(script)


def press_key_code(key_code: int, *, delay_seconds: float = 0.1) -> None:
    script = f"""
tell application {applescript_string(APP_NAME)} to activate
delay {delay_seconds}
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        key code {key_code}
    end tell
end tell
"""
    run_osascript(script)


def start_reply(menu_item: str, *, dry_run: bool = False) -> None:
    click_menu_item("Message", menu_item, dry_run=dry_run)


def start_move(destination: str, *, dry_run: bool = False, open_delay: float = 0.15) -> None:
    if dry_run:
        print(f"Would open Message > Move to… and type {destination!r}")
        return
    click_menu_item("Message", "Move to…")
    type_text_in_mimestream(destination, delay_seconds=open_delay)
    press_key_code(36, delay_seconds=open_delay)


def close_window_by_title(title: str, *, dry_run: bool = False) -> None:
    if dry_run:
        print(f"Would close window {title!r}")
        return
    script = f"""
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        if not (exists window {applescript_string(title)}) then
            error "Window not found: " & {applescript_string(title)}
        end if
        perform action "AXPress" of value of attribute "AXCloseButton" of window {applescript_string(title)}
    end tell
end tell
"""
    run_osascript(script)


def current_compose_from_options(*, wait_seconds: float = 0.35) -> list[str]:
    script = f"""
tell application {applescript_string(APP_NAME)} to activate
delay {wait_seconds}
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        if not (exists front window) then
            error "No front window."
        end if
        set draftWindow to front window
        set fromPopup to missing value
        set totalElements to count of UI elements of draftWindow
