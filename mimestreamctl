def ax_reader_source_path() -> Path:
    return Path(__file__).with_name("mimestream_ax_text.swift")


def ax_reader_binary_path() -> Path:
    return Path("/tmp/mimestreamctl-ax-text")


def ensure_ax_reader_binary() -> Path:
    source_path = ax_reader_source_path()
    binary_path = ax_reader_binary_path()
    if binary_path.exists() and binary_path.stat().st_mtime >= source_path.stat().st_mtime:
        return binary_path
    proc = run_process(["swiftc", str(source_path), "-O", "-o", str(binary_path)])
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    return binary_path


def read_current_message_ax(*, full: bool = False, include_body: bool = True) -> dict[str, str | None]:
    binary_path = ensure_ax_reader_binary()
    argv = [str(binary_path), "--json"]
    if full:
        argv.append("--full")
    if not include_body:
        argv.append("--no-body")
    proc = run_process(argv)
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise CliError(f"Could not decode AX helper output: {exc}") from exc
    if not isinstance(payload, dict):
        raise CliError("Unexpected AX helper output.")
    return {key: value for key, value in payload.items() if value is not None}


