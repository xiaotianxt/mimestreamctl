MARKDOWN_LINK_RE = re.compile(r"^\[(?P<title>.*)\]\((?P<url>.*)\)$")
MIMESTREAM_PRIVATE_LINK_RE = re.compile(r"^https://links\.mimestream\.com/g/(?P<account>[^/]+)/t/(?P<message_id>[^/?#]+)$")


def applescript_string(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def run_process(argv: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        input=input_text,
        text=True,
        capture_output=True,
        check=False,
    )


def normalize_error(raw: str) -> str:
    lines = [line.strip() for line in raw.splitlines() if line.strip()]
    if not lines:
        return "Command failed."
    message = lines[-1]
    if "execution error:" in message:
        message = message.split("execution error:", 1)[1].strip()
    if "Not authorized to send Apple events" in raw or "(-1743)" in raw:
        return (
            f"{message}\n"
            "Grant your terminal app Automation/Accessibility access for System Events and Mimestream, then retry."
        )
    if "(-10827)" in raw:
        return (
            f"{message}\n"
            "The GUI session is not reachable. Run this inside your logged-in macOS desktop session."
        )
    return message


def run_osascript(script: str) -> str:
    argv = ["osascript"]
    for line in script.splitlines():
        argv.extend(["-e", line])
    proc = run_process(argv)
    stdout = proc.stdout.strip()
    stderr = proc.stderr.strip()
    if proc.returncode != 0:
        raise CliError(normalize_error(stderr or stdout))
    return stdout


def run_open(url: str) -> None:
    proc = run_process(["open", "-a", APP_NAME, url])
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))


def activate_mimestream(*, delay_seconds: float = 0.0) -> None:
    script_lines = [f"tell application {applescript_string(APP_NAME)} to activate"]
    if delay_seconds > 0:
        script_lines.append(f"delay {delay_seconds}")
    run_osascript("\n".join(script_lines))


