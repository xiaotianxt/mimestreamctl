def selected_row_metadata() -> dict[str, str | None]:
    script = """
tell application "System Events"
    tell process "Mimestream"
        if not (exists front window) then
            error "No front window."
        end if
        set splitGroup to missing value
        repeat with childElement in UI elements of front window
            if role of childElement is "AXSplitGroup" then
                set splitGroup to childElement
                exit repeat
            end if
        end repeat
        if splitGroup is missing value then
            error "Could not find the main split view."
        end if
        set scrollAreas to UI elements of splitGroup
        set messageListArea to missing value
        repeat with candidateArea in scrollAreas
            if role of candidateArea is "AXScrollArea" then
                repeat with areaChild in UI elements of candidateArea
                    if role of areaChild is "AXTable" then
                        set messageListArea to candidateArea
                        exit repeat
                    end if
                end repeat
                if messageListArea is not missing value then exit repeat
            end if
        end repeat
        if messageListArea is missing value then
            error "Could not find the message list."
        end if
        set messageTable to missing value
        repeat with areaChild in UI elements of messageListArea
            if role of areaChild is "AXTable" then
                set messageTable to areaChild
                exit repeat
            end if
        end repeat
        if messageTable is missing value then
            error "Could not find the message table."
        end if
        set selectedRowCount to count rows of messageTable whose selected is true
        if selectedRowCount is 0 then
            error "No selected message row."
        end if
        set selectedCell to UI element 1 of (first row of messageTable whose selected is true)
        set parts to name of UI elements of selectedCell
    end tell
end tell
set normalizedParts to {}
repeat with partValue in parts
    if partValue is missing value then
        copy "" to end of normalizedParts
    else
        copy (partValue as text) to end of normalizedParts
    end if
end repeat
set AppleScript's text item delimiters to linefeed
return normalizedParts as text
"""
    lines = run_osascript(script).splitlines()
    values = [line.strip() for line in lines]

    def normalize(value: str | None) -> str | None:
        if value is None:
            return None
        if not value or value == "missing value":
            return None
        return value

    sender = normalize(values[0] if len(values) > 0 else None)
    date_text = normalize(values[1] if len(values) > 1 else None)
    subject = normalize(values[2] if len(values) > 2 else None)
    preview = normalize(values[4] if len(values) > 4 else None)
    return {
        "sender": sender,
        "date": date_text,
        "subject": subject,
        "preview": preview,
    }


def compose_mailto_url(
    to: list[str],
    cc: list[str],
    bcc: list[str],
    subject: str | None,
    body: str | None,
) -> str:
    recipients = ",".join(to)
    query: dict[str, str] = {}
    if cc:
        query["cc"] = ",".join(cc)
    if bcc:
        query["bcc"] = ",".join(bcc)
    if subject is not None:
        query["subject"] = subject
    if body is not None:
        query["body"] = body
    query_string = urlencode(query, quote_via=quote)
    base = f"mailto:{quote(recipients, safe='@,')}"
    return f"{base}?{query_string}" if query_string else base


