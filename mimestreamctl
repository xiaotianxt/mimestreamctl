MARKDOWN_LINK_RE = re.compile(r"^\[(?P<title>.*)\]\((?P<url>.*)\)$")
MIMESTREAM_PRIVATE_LINK_RE = re.compile(r"^https://links\.mimestream\.com/g/(?P<account>[^/]+)/t/(?P<message_id>[^/?#]+)$")


def applescript_string(value: str) -> str:
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def run_process(argv: list[str], *, input_text: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        input=input_text,
        text=True,
        capture_output=True,
        check=False,
    )


def normalize_error(raw: str) -> str:
    lines = [line.strip() for line in raw.splitlines() if line.strip()]
    if not lines:
        return "Command failed."
    message = lines[-1]
    if "execution error:" in message:
        message = message.split("execution error:", 1)[1].strip()
    if "Not authorized to send Apple events" in raw or "(-1743)" in raw:
        return (
            f"{message}\n"
            "Grant your terminal app Automation/Accessibility access for System Events and Mimestream, then retry."
        )
    if "(-10827)" in raw:
        return (
            f"{message}\n"
            "The GUI session is not reachable. Run this inside your logged-in macOS desktop session."
        )
    return message


def run_osascript(script: str) -> str:
    proc = run_process(["osascript", "-"], input_text=script)
    stdout = proc.stdout.strip()
    stderr = proc.stderr.strip()
    if proc.returncode != 0:
        raise CliError(normalize_error(stderr or stdout))
    return stdout


def run_open(url: str) -> None:
    proc = run_process(["open", "-a", APP_NAME, url])
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))


def top_menus() -> list[str]:
    script = f"""
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        set menuNames to name of every menu bar item of menu bar 1
    end tell
end tell
set AppleScript's text item delimiters to linefeed
return menuNames as text
"""
    output = run_osascript(script)
    return [line for line in output.splitlines() if line]


def menu_items(menu_name: str) -> list[str]:
    script = f"""
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        if not (exists menu bar item {applescript_string(menu_name)} of menu bar 1) then
            error "Top-level menu not found: " & {applescript_string(menu_name)}
        end if
        set itemNames to {{}}
        repeat with menuItemRef in every menu item of menu 1 of menu bar item {applescript_string(menu_name)} of menu bar 1
            set itemName to name of menuItemRef
            if itemName is not missing value then
                copy itemName to end of itemNames
            end if
        end repeat
    end tell
end tell
set AppleScript's text item delimiters to linefeed
return itemNames as text
"""
    output = run_osascript(script)
    return [line for line in output.splitlines() if line]


def current_selection() -> list[str]:
    script = f"""
tell application id {applescript_string(APP_BUNDLE_ID)}
    set sel to selection
end tell
if sel is missing value then
    return ""
end if
if class of sel is list then
    set AppleScript's text item delimiters to linefeed
    return sel as text
end if
return sel as text
"""
    output = run_osascript(script)
    return [line for line in output.splitlines() if line]


def parse_markdown_link(value: str) -> tuple[str | None, str | None]:
    match = MARKDOWN_LINK_RE.match(value)
    if not match:
        return None, None
    return match.group("title"), match.group("url")


def derive_message_links(selection_url: str | None) -> dict[str, str]:
    if not selection_url:
        return {}
    match = MIMESTREAM_PRIVATE_LINK_RE.match(selection_url)
    links = {"private_link": selection_url}
    if not match:
        return links
    account = match.group("account")
    message_id = match.group("message_id")
    links["mimestream_open_url"] = f"mimestream:///open/g/{account}/t/{message_id}"
    links["gmail_url"] = f"https://mail.google.com/mail?{urlencode({'authuser': account})}#all/{message_id}"
    return links


def applescript_list(values: list[str]) -> str:
    return "{" + ", ".join(applescript_string(value) for value in values) + "}"


def click_menu_item(menu_name: str, item_name: str, *, dry_run: bool = False) -> None:
    if dry_run:
        print(f"Would click {menu_name} > {item_name}")
        return
    script = f"""
tell application id {applescript_string(APP_BUNDLE_ID)} to activate
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        if not (exists menu bar item {applescript_string(menu_name)} of menu bar 1) then
            error "Top-level menu not found: " & {applescript_string(menu_name)}
        end if
        if not (exists menu item {applescript_string(item_name)} of menu 1 of menu bar item {applescript_string(menu_name)} of menu bar 1) then
            error "Menu item not found: " & {applescript_string(menu_name)} & " > " & {applescript_string(item_name)}
        end if
        set targetItem to menu item {applescript_string(item_name)} of menu 1 of menu bar item {applescript_string(menu_name)} of menu bar 1
        if enabled of targetItem is false then
            error "Menu item is disabled: " & {applescript_string(menu_name)} & " > " & {applescript_string(item_name)}
        end if
        click targetItem
    end tell
end tell
"""
    run_osascript(script)


def front_window_title() -> str:
    return run_osascript(
        f'tell application "System Events" to tell process {applescript_string(APP_NAME)} to name of front window'
    )


def selected_row_metadata() -> dict[str, str | None]:
    script = """
tell application "System Events"
    tell process "Mimestream"
        if not (exists front window) then
            error "No front window."
        end if
        set splitGroup to missing value
        repeat with childElement in UI elements of front window
            if role of childElement is "AXSplitGroup" then
                set splitGroup to childElement
                exit repeat
            end if
        end repeat
        if splitGroup is missing value then
            error "Could not find the main split view."
        end if
        set scrollAreas to UI elements of splitGroup
        set messageListArea to missing value
        repeat with candidateArea in scrollAreas
            if role of candidateArea is "AXScrollArea" then
                repeat with areaChild in UI elements of candidateArea
                    if role of areaChild is "AXTable" then
                        set messageListArea to candidateArea
                        exit repeat
                    end if
                end repeat
                if messageListArea is not missing value then exit repeat
            end if
        end repeat
        if messageListArea is missing value then
            error "Could not find the message list."
        end if
        set messageTable to missing value
        repeat with areaChild in UI elements of messageListArea
            if role of areaChild is "AXTable" then
                set messageTable to areaChild
                exit repeat
            end if
        end repeat
        if messageTable is missing value then
            error "Could not find the message table."
        end if
        set selectedRowCount to count rows of messageTable whose selected is true
        if selectedRowCount is 0 then
            error "No selected message row."
        end if
        set selectedCell to UI element 1 of (first row of messageTable whose selected is true)
        set parts to name of UI elements of selectedCell
    end tell
end tell
set normalizedParts to {}
repeat with partValue in parts
    if partValue is missing value then
        copy "" to end of normalizedParts
    else
        copy (partValue as text) to end of normalizedParts
    end if
end repeat
set AppleScript's text item delimiters to linefeed
return normalizedParts as text
"""
    lines = run_osascript(script).splitlines()
    values = [line.strip() for line in lines]

    def normalize(value: str | None) -> str | None:
        if value is None:
            return None
        if not value or value == "missing value":
            return None
        return value

    sender = normalize(values[0] if len(values) > 0 else None)
    date_text = normalize(values[1] if len(values) > 1 else None)
    subject = normalize(values[2] if len(values) > 2 else None)
    preview = normalize(values[4] if len(values) > 4 else None)
    return {
        "sender": sender,
        "date": date_text,
        "subject": subject,
        "preview": preview,
    }


def compose_mailto_url(
    to: list[str],
    cc: list[str],
    bcc: list[str],
    subject: str | None,
    body: str | None,
) -> str:
    recipients = ",".join(to)
    query: dict[str, str] = {}
    if cc:
        query["cc"] = ",".join(cc)
    if bcc:
        query["bcc"] = ",".join(bcc)
    if subject is not None:
        query["subject"] = subject
    if body is not None:
        query["body"] = body
    query_string = urlencode(query, quote_via=quote)
    base = f"mailto:{quote(recipients, safe='@,')}"
    return f"{base}?{query_string}" if query_string else base


def read_text_argument(text: str | None, file_path: str | None) -> str | None:
    if text is not None and file_path is not None:
        raise CliError("Pass either inline text or --file, not both.")
    if file_path is not None:
        return Path(file_path).read_text(encoding="utf-8")
    return text


def set_text_clipboard(text: str) -> None:
    proc = run_process(["pbcopy"], input_text=text)
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))


def get_text_clipboard() -> str:
    proc = run_process(["pbpaste"])
    if proc.returncode != 0:
        return ""
    return proc.stdout


def paste_into_mimestream(*, dry_run: bool = False, delay_seconds: float = 0.15) -> None:
    if dry_run:
        print("Would activate Mimestream and paste clipboard contents")
        return
    script = f"""
tell application id {applescript_string(APP_BUNDLE_ID)} to activate
delay {delay_seconds}
tell application "System Events"
    tell process {applescript_string(APP_NAME)}
        keystroke "v" using command down
    end tell
end tell
"""
    run_osascript(script)


def ax_reader_source_path() -> Path:
    return Path(__file__).with_name("mimestream_ax_text.swift")


def ax_reader_binary_path() -> Path:
    return Path("/tmp/mimestreamctl-ax-text")


def ensure_ax_reader_binary() -> Path:
    source_path = ax_reader_source_path()
    binary_path = ax_reader_binary_path()
    if binary_path.exists() and binary_path.stat().st_mtime >= source_path.stat().st_mtime:
        return binary_path
    proc = run_process(["swiftc", str(source_path), "-O", "-o", str(binary_path)])
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    return binary_path


def copy_current_message_body() -> str:
    binary_path = ensure_ax_reader_binary()
    proc = run_process([str(binary_path)])
    if proc.returncode != 0:
        raise CliError(normalize_error(proc.stderr or proc.stdout))
    copied_text = proc.stdout.strip()
    if not copied_text:
        raise CliError("Could not extract the current message body.")
    return copied_text


