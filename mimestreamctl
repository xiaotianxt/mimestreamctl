def render_read_markdown(metadata: dict[str, str | None]) -> None:
    subject = metadata.get("subject") or metadata.get("title") or "(No subject)"
    print(f"# {subject}")
    print()

    fields = [
        ("Window", metadata.get("window")),
        ("From", metadata.get("sender")),
        ("Date", metadata.get("date")),
        ("Preview", metadata.get("preview")),
    ]
    for label, value in fields:
        if value:
            print(f"- {label}: {value}")

    link_rows = [
        ("Private Link", metadata.get("private_link")),
        ("Open in Mimestream", metadata.get("mimestream_open_url")),
        ("Open in Gmail", metadata.get("gmail_url")),
    ]
    visible_links = [(label, url) for label, url in link_rows if url]
    if visible_links:
        if any(value for _, value in fields):
            print()
        print("## Links")
        print()
        for label, url in visible_links:
            print(render_markdown_link(label, url))

    body = metadata.get("body")
    if body:
        print()
        print("## Body")
        print()
        print(body)


